<Project>

  <!--
    Directory.Build.props — solution-wide MSBuild defaults.
    See .claude/conventions/dotnet.md "Code Style". Place at the repo root so every
    project inherits it. This is the home for the rules .editorconfig can't express
    (Nullable, LangVersion) plus the switch that makes .editorconfig style rules fail
    the build (EnforceCodeStyleInBuild).
  -->

  <PropertyGroup>
    <!-- Nullable reference types — the `<Nullable>enable</Nullable>` rule -->
    <Nullable>enable</Nullable>

    <!-- Latest C# so primary constructors, collection expressions ([]) etc. are available -->
    <LangVersion>latest</LangVersion>

    <!-- Reduce using boilerplate across the stack -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Run the .editorconfig / IDExxxx style analyzers at build time (not just in the IDE) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Style/analyzer warnings (file-scoped namespaces, braces, CA1852, …) fail the build.
         Scope with <WarningsNotAsErrors> if a specific rule is too strict for a project. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Deterministic, reproducible builds ("build once, run anywhere") -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
