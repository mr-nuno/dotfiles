# env.example — copy to `.env` and fill in. `.env` is gitignored; `.env.example` is committed.
# LOCAL DEVELOPMENT values only — never put real production secrets here.
# Consumed by docker-compose.yml (env_file: .env) and compose ${VAR} substitution.

# --- SQL Server (password must satisfy SQL Server complexity: 8+ chars, mixed case, digit, symbol) ---
SA_PASSWORD=Your_password123

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
# Keep the password below in sync with SA_PASSWORD above.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=AppDb;User=sa;Password=Your_password123;TrustServerCertificate=true

# --- Auth: Entra ID (fill from your app registration; leave blank locally if not testing auth) ---
# AzureAd__TenantId=
# AzureAd__ClientId=
# AzureAd__ClientSecret=
