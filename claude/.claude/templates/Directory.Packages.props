<Project>

  <!--
    Directory.Packages.props — Central Package Management (CPM).
    See .claude/conventions/dotnet.md "Tech Stack". Place at the repo root; projects then
    reference packages WITHOUT a Version attribute (<PackageReference Include="MediatR" />)
    and the version is resolved from here.

    VERSIONS: only MediatR (12.5.0) and StronglyTypedId (1.0.0-beta08) are pinned by
    convention and MUST NOT drift. Everything else is a .NET 10-era starting point;
    verify/bump against NuGet after the first restore ("dotnet list package" + outdated flag).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- API — endpoints & docs -->
  <ItemGroup>
    <PackageVersion Include="FastEndpoints" Version="7.0.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.0.0" />
  </ItemGroup>

  <!-- Application — CQRS, validation, result pattern -->
  <ItemGroup>
    <!-- PINNED BY CONVENTION: last Apache-2.0 MediatR. Do NOT raise past 12.5.0 (v13+ is commercial). -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <!-- 12.x required: FastEndpoints 7.0.0 depends on FluentValidation 12.x; 11.x fails the build
         with CS1705 (assembly version mismatch). -->
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageVersion Include="Ardalis.Result" Version="10.1.0" />
    <PackageVersion Include="Ardalis.Result.FluentValidation" Version="10.1.0" />
    <PackageVersion Include="Ardalis.Specification" Version="9.1.0" />
    <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.1.0" />
  </ItemGroup>

  <!-- Domain -->
  <ItemGroup>
    <!-- PINNED BY CONVENTION: source generator for strongly typed IDs. -->
    <PackageVersion Include="StronglyTypedId" Version="1.0.0-beta08" />
  </ItemGroup>

  <!-- Infrastructure — EF Core (SQL Server), resilience -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>

  <!-- Logging — Serilog (Console + Seq) -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />
  </ItemGroup>

  <!-- Auth — Entra ID JWT bearer -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <!-- Testing — xUnit + Shouldly + NSubstitute + Testcontainers + Respawn -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!-- 4.9+ required: exposes the MsSqlBuilder(image) constructor the testing doc mandates, and
         its readiness wait doesn't return until SQL Server accepts logins over the mapped port
         (4.0.0's wait returns too early → transient "Login failed for user 'sa'"). -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.10.0" />
    <!-- Respawn v7+ (uses DbConnection, not connection strings) -->
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

</Project>
