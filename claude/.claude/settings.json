{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(**/private/**)",
      "Read(//home/peter/Projects/private/**)",
      "Edit(**/private/**)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|BashOutput|Read|Edit|Write|NotebookEdit|Grep|Glob|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-private-paths.py",
            "timeout": 10,
            "statusMessage": "Checking for private/ paths..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/peter/.claude/skills/impeccable/scripts/impeccable' ] || '/home/peter/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/peter/.claude/skills/impeccable/scripts/impeccable' ] || '/home/peter/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/peter/.claude/skills/impeccable/scripts/impeccable' ] || '/home/peter/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "tui": "default",
  "theme": "dark",
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
